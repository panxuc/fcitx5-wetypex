# Native offline inference uses only Rust's standard library. No Cargo index,
# package downloads, model weights, or CPU-native build flags are involved.
if(NOT DEFINED WETYPE_ENABLE_VOICE OR WETYPE_ENABLE_VOICE)
  find_program(WETYPE_RUSTC rustc)
  if(NOT WETYPE_RUSTC)
    message(FATAL_ERROR "Install rustc 1.73+ to build offline voice")
  endif()
  execute_process(COMMAND "${WETYPE_RUSTC}" --version OUTPUT_VARIABLE rust_version
    OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE rust_result)
  if(NOT rust_result EQUAL 0)
    message(FATAL_ERROR "Cannot run rustc")
  endif()
  string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" rust_version "${rust_version}")
  if(rust_version VERSION_LESS "1.73")
    message(FATAL_ERROR "Offline voice requires rustc 1.73+ (Ubuntu 20.04 updates provides 1.75)")
  endif()
  set(rust_flags --edition=2021 -C opt-level=3 -C panic=abort -C strip=symbols -C lto=thin)
  if(NOT rust_version VERSION_LESS "1.89")
    list(APPEND rust_flags --cfg wetype_vnni)
  endif()
  set(WETYPE_RUST_TARGET "" CACHE STRING "Rust target triple when cross-compiling offline voice")
  if(WETYPE_RUST_TARGET)
    list(APPEND rust_flags --target "${WETYPE_RUST_TARGET}" -C "linker=${CMAKE_CXX_COMPILER}")
  elseif(CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Set WETYPE_RUST_TARGET and install its Rust standard library when cross-compiling")
  endif()
  file(GLOB rust_sources CONFIGURE_DEPENDS "${CMAKE_CURRENT_SOURCE_DIR}/src/localvoice/*.rs")
  set(local_voice_binary "${CMAKE_CURRENT_BINARY_DIR}/wetypex-local-voice")
  add_custom_command(OUTPUT "${local_voice_binary}"
    COMMAND "${WETYPE_RUSTC}" ${rust_flags} "${CMAKE_CURRENT_SOURCE_DIR}/src/localvoice/main.rs" -o "${local_voice_binary}"
    DEPENDS ${rust_sources} VERBATIM)
  add_custom_target(wetypex-local-voice-build ALL DEPENDS "${local_voice_binary}")
  install(PROGRAMS "${local_voice_binary}" DESTINATION "${CMAKE_INSTALL_LIBDIR}/fcitx5-wetypex")
  add_executable(wetypex-sherpa-voice src/sherpavoice/main.cpp)
  target_link_libraries(wetypex-sherpa-voice PRIVATE Threads::Threads ${CMAKE_DL_LIBS})
  target_compile_options(wetypex-sherpa-voice PRIVATE -Wall -Wextra)
  install(TARGETS wetypex-sherpa-voice RUNTIME DESTINATION "${CMAKE_INSTALL_LIBDIR}/fcitx5-wetypex")
  install(FILES src/sherpavoice/LICENSE src/sherpavoice/ONNX-RUNTIME-LICENSE src/sherpavoice/SILERO-VAD-LICENSE src/sherpavoice/NOTICE.md DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/fcitx5-wetypex/sherpa-voice")
  install(FILES scripts/optional_voice.py data/optional-voice-models.json DESTINATION "${CMAKE_INSTALL_DATADIR}/fcitx5-wetypex")
  install(FILES scripts/local_voice.py data/local-voice-model.json DESTINATION "${CMAKE_INSTALL_DATADIR}/fcitx5-wetypex")
  install(FILES src/localvoice/LICENSE-MIT DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/fcitx5-wetypex" RENAME local-voice-MIT)
  install(FILES src/localvoice/NOTICE.md DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/fcitx5-wetypex" RENAME local-voice-NOTICE.md)
endif()
