# Some distribution CMake packages embed /usr paths instead of deriving their
# installed prefix. Keep optional cross builds inside the selected SDK too.
if(CMAKE_CROSSCOMPILING AND CMAKE_SYSROOT)
  foreach(imported Fcitx5::Core Fcitx5::Config Fcitx5::Utils Fcitx5::Module::Clipboard
                   LibIME::Core LibIME::Pinyin)
    if(NOT TARGET "${imported}")
      continue()
    endif()
    get_target_property(alias "${imported}" ALIASED_TARGET)
    if(alias)
      set(imported "${alias}")
    endif()
    get_target_property(configurations "${imported}" IMPORTED_CONFIGURATIONS)
    set(properties IMPORTED_LOCATION INTERFACE_INCLUDE_DIRECTORIES INTERFACE_LINK_DIRECTORIES)
    foreach(configuration IN LISTS configurations)
      string(TOUPPER "${configuration}" configuration)
      list(APPEND properties "IMPORTED_LOCATION_${configuration}")
    endforeach()
    foreach(property IN LISTS properties)
      get_target_property(paths "${imported}" "${property}")
      if(NOT paths)
        continue()
      endif()
      set(resolved)
      foreach(path IN LISTS paths)
        if(path MATCHES "^/usr/" AND EXISTS "${CMAKE_SYSROOT}${path}")
          list(APPEND resolved "${CMAKE_SYSROOT}${path}")
        else()
          list(APPEND resolved "${path}")
        endif()
      endforeach()
      set_property(TARGET "${imported}" PROPERTY "${property}" "${resolved}")
    endforeach()
  endforeach()
endif()
