# A native ARM64 runner needs no toolchain file. This optional SDK toolchain
# also supports isolated, real-application verification from an x86-64 host.
set(CMAKE_SYSTEM_NAME Linux)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
if(NOT DEFINED ENV{WETYPE_SYSROOT})
  message(FATAL_ERROR "Set WETYPE_SYSROOT to the target distribution SDK")
endif()
set(CMAKE_SYSROOT "$ENV{WETYPE_SYSROOT}")
if(NOT CMAKE_C_COMPILER)
  set(CMAKE_C_COMPILER clang)
endif()
if(NOT CMAKE_CXX_COMPILER)
  set(CMAKE_CXX_COMPILER clang++)
endif()
set(CMAKE_C_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_CXX_COMPILER_TARGET aarch64-linux-gnu)
set(CMAKE_C_FLAGS_INIT "-isystem ${CMAKE_SYSROOT}/usr/include/aarch64-linux-gnu -isystem ${CMAKE_SYSROOT}/usr/include")
set(CMAKE_CXX_FLAGS_INIT "")
set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ENV{PKG_CONFIG_SYSROOT_DIR} "${CMAKE_SYSROOT}")
set(ENV{PKG_CONFIG_LIBDIR} "${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu/pkgconfig:${CMAKE_SYSROOT}/usr/lib/pkgconfig:${CMAKE_SYSROOT}/usr/share/pkgconfig")

# Select the SDK C++ headers and runtime too, so a newer host compiler does
# not accidentally raise the target distribution's GLIBCXX requirement.
file(GLOB sdk_cxx_candidates LIST_DIRECTORIES true "${CMAKE_SYSROOT}/usr/include/c++/*")
set(sdk_cxx_versions)
foreach(path IN LISTS sdk_cxx_candidates)
  get_filename_component(version "${path}" NAME)
  if(version MATCHES "^[0-9]+(\\.[0-9]+)*$")
    list(APPEND sdk_cxx_versions "${path}")
  endif()
endforeach()
list(SORT sdk_cxx_versions COMPARE NATURAL)
list(LENGTH sdk_cxx_versions sdk_cxx_count)
if(sdk_cxx_count GREATER 0)
  list(GET sdk_cxx_versions -1 sdk_cxx)
  get_filename_component(sdk_cxx_version "${sdk_cxx}" NAME)
  string(APPEND CMAKE_CXX_FLAGS_INIT " -nostdinc++ -isystem \"${sdk_cxx}\" -isystem \"${CMAKE_SYSROOT}/usr/include/aarch64-linux-gnu/c++/${sdk_cxx_version}\" -isystem \"${sdk_cxx}/backward\"")
  file(GLOB sdk_gcc_dirs LIST_DIRECTORIES true "${CMAKE_SYSROOT}/usr/lib/gcc/*/${sdk_cxx_version}")
  foreach(directory IN LISTS sdk_gcc_dirs)
    if(IS_DIRECTORY "${directory}")
      set(sdk_gcc "${directory}")
      get_filename_component(triple_directory "${directory}" DIRECTORY)
      get_filename_component(sdk_triple "${triple_directory}" NAME)
      if(EXISTS "${sdk_cxx}/${sdk_triple}/bits/c++config.h")
        string(APPEND CMAKE_CXX_FLAGS_INIT " -isystem \"${sdk_cxx}/${sdk_triple}\"")
      endif()
      break()
    endif()
  endforeach()
endif()
# libstdc++ uses include_next for C headers. Its SDK C++ directories must
# precede the SDK C directories, otherwise GCC falls through to host headers.
string(APPEND CMAKE_CXX_FLAGS_INIT " ${CMAKE_C_FLAGS_INIT}")
set(sdk_link_flags "-L\"${sdk_gcc}\" -L\"${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu\" -L\"${CMAKE_SYSROOT}/usr/lib\" -Wl,-rpath-link,\"${CMAKE_SYSROOT}/usr/lib/aarch64-linux-gnu\" -Wl,-rpath-link,\"${CMAKE_SYSROOT}/usr/lib\"")
string(APPEND sdk_link_flags " -L\"${CMAKE_SYSROOT}/lib/aarch64-linux-gnu\" -L\"${CMAKE_SYSROOT}/lib\" -Wl,-rpath-link,\"${CMAKE_SYSROOT}/lib/aarch64-linux-gnu\" -Wl,-rpath-link,\"${CMAKE_SYSROOT}/lib\"")
set(CMAKE_EXE_LINKER_FLAGS_INIT "${sdk_link_flags}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${sdk_link_flags}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${sdk_link_flags}")
