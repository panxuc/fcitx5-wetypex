#!/bin/sh
set -eu
umask 077
runtime="${WETYPE_RUNTIME_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5-wetypex/runtime}"
state="${WETYPE_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5-wetypex/state}"
account="${WETYPE_ACCOUNT_STATE_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5-wetypex/account}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
support="${WETYPE_SUPPORT_DIR:-@WETYPE_SUPPORT_DIR@}"
test -f "$runtime/manifest.txt" || { echo 'Run fcitx5-wetypex-setup first.' >&2; exit 78; }
mkdir -p "$state/user"
chmod 700 "$state"
python3 - "$state/user/persistent_data" "$state/user/network" <<'PY'
import pathlib, shutil, sys
for value in sys.argv[1:]:
    path = pathlib.Path(value)
    if path.exists():
        shutil.rmtree(path)
PY
if [ "${WETYPE_DEBUG:-0}" != 1 ]; then exec 2>/dev/null; fi

standalone=0
if [ -f "$config_home/fcitx5/wetypex.json" ]; then
  standalone="$(python3 -c 'import json,sys; print(1 if json.load(open(sys.argv[1])).get("standalone",False) else 0)' "$config_home/fcitx5/wetypex.json" 2>/dev/null || printf 0)"
fi

# The original desktop enables cloud candidates only when networking is
# available.  Pairing initializes this per-user anonymous device identity.
if [ "$standalone" = 0 ] && [ -f "$account/identity.json" ]; then
  uin="$(python3 -c 'import json,sys; v=json.load(open(sys.argv[1])); print(v.get("uin", ""))' "$account/identity.json" 2>/dev/null || true)"
  device_code="$(python3 -c 'import json,sys; v=json.load(open(sys.argv[1])); print(v.get("device_code", ""))' "$account/identity.json" 2>/dev/null || true)"
  model="$(cat /sys/class/dmi/id/product_name 2>/dev/null || true)"
  group_id=0
  group_functions=0
  hotword_version=0
  if [ -f "$state/sync-state.json" ]; then
    group_id="$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("group_id",0)))' "$state/sync-state.json" 2>/dev/null || printf 0)"
    group_functions="$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("func_switch",0)))' "$state/sync-state.json" 2>/dev/null || printf 0)"
    hotword_version="$(python3 -c 'import json,sys; print(int(json.load(open(sys.argv[1])).get("hotword_version",0)))' "$state/sync-state.json" 2>/dev/null || printf 0)"
  fi
  test -n "$model" || model=LINUX
  if [ -n "$uin" ] && [ -n "$device_code" ]; then
    exec flock -w 5 -E 73 "$state/backend.lock" bwrap --unshare-pid --die-with-parent \
      --ro-bind /usr /usr --symlink usr/lib /lib --ro-bind /lib64 /lib64 --symlink usr/bin /bin \
      --proc /proc --dev /dev --tmpfs /tmp --dir /etc \
      --ro-bind /etc/resolv.conf /etc/resolv.conf --ro-bind /etc/hosts /etc/hosts \
      --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf --ro-bind /etc/ssl /etc/ssl \
      --ro-bind /etc/ca-certificates /etc/ca-certificates \
      --ro-bind "$runtime" /input --ro-bind "$support" /support --bind "$state" /work \
      --chdir /work --clearenv --setenv PATH /usr/bin --setenv HOME /work \
      --setenv TZ "${TZ:-Asia/Shanghai}" --setenv WETYPE_SUPPORT_DIR /support \
      --setenv WETYPE_NETWORK_LIVE 1 --setenv WETYPE_CORE_UIN "$uin" \
      --setenv WETYPE_CORE_DEVICE_CODE "$device_code" --setenv WETYPE_DEVICE_MODEL "$model" \
      --setenv WETYPE_GROUP_ID "$group_id" --setenv WETYPE_GROUP_FUNCTIONS "$group_functions" \
      --setenv WETYPE_HOTWORD_VERSION "$hotword_version" \
      /support/wetypex-engine-host /input serve
  fi
fi

# Offline and standalone sessions retain a private network namespace.
exec flock -w 5 -E 73 "$state/backend.lock" bwrap --unshare-net --unshare-pid --die-with-parent \
  --ro-bind /usr /usr --symlink usr/lib /lib --ro-bind /lib64 /lib64 --symlink usr/bin /bin \
  --proc /proc --dev /dev --tmpfs /tmp \
  --ro-bind "$runtime" /input --ro-bind "$support" /support --bind "$state" /work \
  --chdir /work --clearenv --setenv PATH /usr/bin --setenv HOME /work \
  --setenv TZ "${TZ:-Asia/Shanghai}" --setenv WETYPE_SUPPORT_DIR /support \
  /support/wetypex-engine-host /input serve
