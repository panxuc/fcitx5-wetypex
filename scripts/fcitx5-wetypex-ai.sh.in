#!/bin/sh
set -eu
umask 077
fetch_only=0
requested_output=
if [ "${1:-}" = --fetch ]; then
  fetch_only=1
  requested_output="$2"
  shift 2
fi
question="$*"
test -n "$question" || { echo 'usage: fcitx5-wetypex-ai QUESTION' >&2; exit 64; }
if [ "$fetch_only" -eq 0 ]; then
  exec @CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-ai-viewer --ask "$question"
fi
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"
runtime="${WETYPE_RUNTIME_DIR:-$data_home/fcitx5-wetypex/runtime}"
account="${WETYPE_ACCOUNT_STATE_DIR:-$data_home/fcitx5-wetypex/account}"
support="${WETYPE_SUPPORT_DIR:-@WETYPE_SUPPORT_DIR@}"
state="${WETYPE_AI_STATE_DIR:-$data_home/fcitx5-wetypex/ai}"
identity="$account/identity.json"
test -f "$runtime/manifest.txt" -a -f "$identity" || { echo 'WeTypeX runtime or paired identity is missing.' >&2; exit 78; }
mkdir -p "$state/user"
chmod 700 "$state"
uin="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["uin"])' "$identity")"
device="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["device_code"])' "$identity")"
if [ "$fetch_only" -eq 1 ]; then
  work="$(mktemp -d "$state/request.XXXXXXXX")"
  trap 'if [ -f "$work/last-ai.log" ]; then mv -f -- "$work/last-ai.log" "$state/last-ai.log"; fi; rm -rf -- "$work"' 0
  trap 'exit 130' INT
  trap 'exit 143' TERM
  mkdir -p "$work/user"
  raw="$work/response.raw"
  html="${requested_output:-$state/response.html}"
  success=0
  attempt=0
  while [ "$attempt" -lt 3 ]; do
    attempt=$((attempt + 1))
    if timeout 50 bwrap --unshare-pid --die-with-parent \
      --ro-bind /usr /usr --symlink usr/lib /lib --ro-bind /lib64 /lib64 --symlink usr/bin /bin \
      --proc /proc --dev /dev --tmpfs /tmp --dir /etc \
      --ro-bind /etc/resolv.conf /etc/resolv.conf --ro-bind /etc/hosts /etc/hosts \
      --ro-bind /etc/nsswitch.conf /etc/nsswitch.conf --ro-bind-try /etc/ssl /etc/ssl \
      --ro-bind-try /etc/pki /etc/pki --ro-bind-try /etc/ca-certificates /etc/ca-certificates \
      --ro-bind "$runtime" /input --ro-bind "$support" /support --bind "$work" /work \
      --chdir /work --clearenv --setenv PATH /usr/bin --setenv HOME /work \
      --setenv WETYPE_SUPPORT_DIR /support --setenv WETYPE_NETWORK_LIVE 1 \
      --setenv WETYPE_CORE_UIN "$uin" --setenv WETYPE_CORE_DEVICE_CODE "$device" \
      --setenv WETYPE_DEVICE_MODEL "$(cat /sys/class/dmi/id/product_name 2>/dev/null || printf LINUX)" \
      /support/wetypex-engine-host /input llm-service "$question" > "$raw" 2> "$work/last-ai.log" && \
      python3 - "$raw" "$html" <<'PY'
import os,pathlib,sys,tempfile
raw=pathlib.Path(sys.argv[1]).read_text(errors='replace')
start=raw.find('<!DOCTYPE html>');end=raw.find('\nLLM_RESULT',start)
if start < 0 or end < 0: raise SystemExit(1)
target=pathlib.Path(sys.argv[2])
fd,temporary=tempfile.mkstemp(prefix='.wetypex-ai-',dir=str(target.parent))
try:
    with os.fdopen(fd,'w') as output: output.write(raw[start:end])
    os.replace(temporary,target)
finally:
    if os.path.exists(temporary): os.unlink(temporary)
PY
    then
      success=1
      break
    fi
    sleep "$attempt"
  done
  if [ "$success" -ne 1 ]; then
    echo 'Official AI service did not return a render document.' >&2
    exit 1
  fi
  chmod 600 "$raw" "$html" "$work/last-ai.log"
  exit 0
fi
