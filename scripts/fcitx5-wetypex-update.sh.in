#!/usr/bin/env python3
"""Download verified WeTypeX release updates for the current Linux family."""

import fcntl
import hashlib
import json
import os
import pathlib
import platform
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

CURRENT_VERSION = "@PROJECT_VERSION@"
CURRENT_PACKAGE_RELEASE = "@WETYPE_PACKAGE_RELEASE@"
RELEASE_API = os.environ.get(
    "WETYPE_UPDATE_API",
    "https://api.github.com/repos/panxuc/fcitx5-wetypex/releases/latest",
)
CHECK_INTERVAL = 24 * 60 * 60
RETRY_INTERVAL = 60 * 60
PACKAGE_UPDATES = True


def version_tuple(value):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)\.(\d+)(?:-(\d+))?", value or "")
    return tuple(int(part or 0) for part in match.groups()) if match else None


def read_json(path, fallback=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {} if fallback is None else fallback


def atomic_json(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def request_bytes(url, timeout=20, limit=4 * 1024 * 1024):
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": f"WeTypeX/{CURRENT_VERSION}",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        data = response.read(limit + 1)
        if len(data) > limit:
            raise ValueError('release metadata exceeds its size limit')
        return data


def download_package(url, target):
    value = hashlib.sha256()
    total = 0
    with urllib.request.urlopen(url, timeout=120) as response, target.open('wb') as output:
        os.chmod(target, 0o600)
        while True:
            block = response.read(1024 * 1024)
            if not block:
                break
            total += len(block)
            if total > 128 * 1024 * 1024:
                raise ValueError('release package exceeds its size limit')
            output.write(block)
            value.update(block)
        output.flush()
        os.fsync(output.fileno())
    return value.hexdigest()


def package_version(name):
    match = re.fullmatch(
        r'fcitx5-wetypex(?:-legacy)?[-_](\d+\.\d+\.\d+\.\d+-\d+)'
        r'(?:_(?:amd64|arm64)\.deb|\.(?:x86_64|aarch64)\.rpm|'
        r'-(?:x86_64|aarch64)\.pkg\.tar\.zst)', name)
    return version_tuple(match[1]) if match else None


def retire_package(root, state, installed):
    """Only remove the unchanged package recorded by our verified download."""
    path = pathlib.Path(state.get('package', ''))
    version = package_version(path.name)
    if (path.parent != root or not version or version > installed or
            path.is_symlink() or not path.is_file()):
        return
    value = hashlib.sha256()
    with path.open('rb') as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b''):
            value.update(block)
    if value.hexdigest() == state.get('sha256'):
        path.unlink()


def linux_family():
    values = {}
    try:
        for line in pathlib.Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value.strip().strip('"')
    except OSError:
        pass
    names = {values.get("ID", ""), *values.get("ID_LIKE", "").split()}
    if "arch" in names:
        return "arch"
    if names & {"debian", "ubuntu"}:
        return "debian"
    if names & {"fedora", "rhel", "centos"}:
        return "fedora"
    return ""


def select_asset(assets, family, release):
    architecture = platform.machine().lower()
    if architecture not in ('x86_64', 'amd64', 'aarch64', 'arm64'):
        return None
    arm = architecture in ('aarch64', 'arm64')
    native, deb = ('aarch64', 'arm64') if arm else ('x86_64', 'amd64')
    exact = re.escape(release.lstrip('v'))
    patterns = {
        "arch": re.compile(rf"^fcitx5-wetypex-{exact}-{native}\.pkg\.tar\.zst$"),
        "debian": re.compile(rf"^fcitx5-wetypex_{exact}_{deb}\.deb$"),
        "fedora": re.compile(rf"^fcitx5-wetypex-{exact}\.{native}\.rpm$"),
    }
    pattern = patterns.get(family)
    if family == "debian":
        try:
            glibc = tuple(int(part) for part in os.confstr("CS_GNU_LIBC_VERSION").split()[-1].split("."))
        except (OSError, ValueError, AttributeError):
            glibc = ()
        if glibc and glibc < (2, 35):
            pattern = re.compile(rf"^fcitx5-wetypex-legacy_{exact}_{deb}\.deb$")
    if not pattern:
        return None
    return next(
        (asset for asset in assets if pattern.fullmatch(asset.get("name", ""))),
        None,
    )


def notify_and_offer_install(package, version, family):
    notify = shutil.which("notify-send")
    if not notify:
        return
    try:
        help_result = subprocess.run([notify, "--help"], capture_output=True,
                                     timeout=3)
        actions = help_result.returncode == 0 and b"--action" in (
            help_result.stdout + help_result.stderr)
    except (OSError, subprocess.TimeoutExpired):
        return
    command = [
        notify,
        "--app-name=WeTypeX",
        "--icon=fcitx5-wetypex",
    ]
    if actions:
        command += ["--action=install=安装更新"]
    command += [f"WeTypeX {version} 已下载", f"已校验软件包：{package}"]
    try:
        selected = subprocess.run(command, capture_output=True, text=True).stdout.strip()
    except OSError:
        return
    if selected != "install" or not shutil.which("pkexec"):
        return
    installers = {
        "arch": ["pacman", "-U", "--noconfirm", str(package)],
        "debian": ["apt-get", "install", "-y", str(package)],
        "fedora": ["dnf", "install", "-y", str(package)],
    }
    subprocess.Popen(["pkexec", *installers[family]], start_new_session=True)


def main():
    config_home = pathlib.Path(
        os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")
    )
    config = read_json(config_home / "fcitx5/wetypex.json")
    if not config.get("auto_update", True) and "--force" not in sys.argv:
        return 0

    cache_home = pathlib.Path(
        os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")
    )
    root = pathlib.Path(
        os.environ.get("WETYPE_UPDATE_DIR", cache_home / "fcitx5-wetypex/updates")
    )
    root.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    lock = open(root / "update.lock", "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return 0
    try:
        check_runtime_update(root)
        return check_update(root) if PACKAGE_UPDATES else 0
    finally:
        lock.close()


def check_runtime_update(update_root):
    """Only prepare profiles shipped with this adapter; activation waits for idle."""
    data = pathlib.Path(os.environ.get('XDG_DATA_HOME', pathlib.Path.home() / '.local/share'))
    root = data / 'fcitx5-wetypex'
    runtime = pathlib.Path(os.environ.get('WETYPE_RUNTIME_DIR', root / 'runtime'))
    state_path = update_root / 'runtime-check.json'
    now = int(time.time())
    if '--force' not in sys.argv and now < int(read_json(state_path).get('next_check', 0)):
        return
    setup = '@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-setup'
    try:
        result = subprocess.run([setup, '--status'], capture_output=True, timeout=30, check=True)
        status = json.loads(result.stdout)
    except (OSError, ValueError, subprocess.SubprocessError):
        atomic_json(state_path, dict(next_check=now + RETRY_INTERVAL))
        return
    desired = status.get('default')
    if (not status.get('update_available') or not desired or
            read_json(root / 'runtime-policy.json').get('suppressed_default') == desired or
            read_json(root / 'runtime-pending.json').get('version') == desired):
        atomic_json(state_path, dict(next_check=now + CHECK_INTERVAL))
        return
    try:
        result = subprocess.run([setup, '--update',
                        '--download', '--accept-upstream-license', '--defer'],
                       stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, timeout=900)
        atomic_json(state_path, dict(next_check=now + (CHECK_INTERVAL if result.returncode == 0 else RETRY_INTERVAL)))
    except (OSError, subprocess.TimeoutExpired):
        atomic_json(state_path, dict(next_check=now + RETRY_INTERVAL))


def check_update(root):
    state_path = root / "state.json"
    state = read_json(state_path)
    interrupted = pathlib.Path(state.get('partial', ''))
    if (interrupted.parent == root and interrupted.name.endswith('.part') and
            package_version(interrupted.name[:-5]) and not interrupted.is_symlink()):
        interrupted.unlink(missing_ok=True)
    now = int(time.time())
    if "--force" not in sys.argv and now < int(state.get("next_check", 0)):
        return 0
    try:
        release = json.loads(request_bytes(RELEASE_API))
        version = version_tuple(release.get("tag_name", ""))
        current = version_tuple(f"{CURRENT_VERSION}-{CURRENT_PACKAGE_RELEASE}")
        if not version or not current:
            raise ValueError("invalid release version")
        if version <= current:
            retire_package(root, state, current)
            atomic_json(
                state_path,
                {
                    "checked_at": now,
                    "next_check": now + CHECK_INTERVAL,
                    "latest_version": release.get("tag_name", ""),
                },
            )
            return 0
        assets = release.get("assets", [])
        family = linux_family()
        package_asset = select_asset(assets, family, release['tag_name'])
        checksums = next(
            (item for item in assets if item.get("name") == "SHA256SUMS"), None
        )
        if not package_asset or not checksums:
            raise ValueError("release has no package for this distribution")
        package = root / package_asset["name"]
        partial = package.with_suffix(package.suffix + ".part")
        state['partial'] = str(partial)
        atomic_json(state_path, state)
        digest = download_package(package_asset["browser_download_url"], partial)
        checksum_text = request_bytes(checksums["browser_download_url"]).decode()
        expected = None
        for line in checksum_text.splitlines():
            fields = line.split()
            if (
                len(fields) >= 2
                and pathlib.PurePosixPath(fields[-1].lstrip("*")).name == package.name
            ):
                expected = fields[0].lower()
                break
        if (
            not expected
            or not re.fullmatch(r"[0-9a-f]{64}", expected)
            or digest != expected
        ):
            partial.unlink(missing_ok=True)
            raise ValueError("release checksum mismatch")
        partial.replace(package)
        # Only remove the package named in our previous verified receipt.
        if pathlib.Path(state.get('package', '')) != package:
            retire_package(root, state, version)
        atomic_json(
            state_path,
            {
                "checked_at": now,
                "next_check": now + CHECK_INTERVAL,
                "latest_version": release.get("tag_name", ""),
                "package": str(package),
                "sha256": digest,
            },
        )
        if os.environ.get("WETYPE_UPDATE_NO_NOTIFY") != "1":
            notify_and_offer_install(
                package, release["tag_name"].lstrip("v"), family
            )
        return 0
    except (
        OSError,
        ValueError,
        KeyError,
        urllib.error.URLError,
        json.JSONDecodeError,
    ) as error:
        partial = pathlib.Path(state.get('partial', ''))
        if partial.parent == root and package_version(partial.name[:-5]) and partial.name.endswith('.part') and not partial.is_symlink():
            partial.unlink(missing_ok=True)
        atomic_json(
            state_path,
            {
                **state,
                "checked_at": now,
                "next_check": now + RETRY_INTERVAL,
                "error": str(error)[:300],
            },
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
