#!/usr/bin/env python3
"""Download verified WeTypeX release updates for the current Linux family."""

import fcntl
import hashlib
import json
import os
import pathlib
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request

CURRENT_VERSION = "@PROJECT_VERSION@"
CURRENT_PACKAGE_RELEASE = "@WETYPE_PACKAGE_RELEASE@"
RELEASE_API = os.environ.get(
    "WETYPE_UPDATE_API",
    "https://api.github.com/repos/panxuc/fcitx5-wetypex/releases/latest",
)
CHECK_INTERVAL = 24 * 60 * 60
RETRY_INTERVAL = 60 * 60


def version_tuple(value):
    match = re.fullmatch(r"v?(\d+)\.(\d+)\.(\d+)\.(\d+)(?:-(\d+))?", value or "")
    return tuple(int(part or 0) for part in match.groups()) if match else None


def read_json(path, fallback=None):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return {} if fallback is None else fallback


def atomic_json(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)


def request_bytes(url, timeout=20):
    request = urllib.request.Request(
        url,
        headers={
            "Accept": "application/vnd.github+json",
            "User-Agent": f"WeTypeX/{CURRENT_VERSION}",
            "X-GitHub-Api-Version": "2022-11-28",
        },
    )
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read()


def linux_family():
    values = {}
    try:
        for line in pathlib.Path("/etc/os-release").read_text().splitlines():
            if "=" in line:
                key, value = line.split("=", 1)
                values[key] = value.strip().strip('"')
    except OSError:
        pass
    names = {values.get("ID", ""), *values.get("ID_LIKE", "").split()}
    if "arch" in names:
        return "arch"
    if names & {"debian", "ubuntu"}:
        return "debian"
    if names & {"fedora", "rhel", "centos"}:
        return "fedora"
    return ""


def select_asset(assets, family):
    patterns = {
        "arch": re.compile(r"^fcitx5-wetypex-[^-]+-\d+-x86_64\.pkg\.tar\.zst$"),
        "debian": re.compile(r"^fcitx5-wetypex_[^_]+_amd64\.deb$"),
        "fedora": re.compile(r"^fcitx5-wetypex-[^-]+-\d+\.x86_64\.rpm$"),
    }
    pattern = patterns.get(family)
    if family == "debian":
        try:
            glibc = tuple(int(part) for part in os.confstr("CS_GNU_LIBC_VERSION").split()[-1].split("."))
        except (OSError, ValueError, AttributeError):
            glibc = ()
        if glibc and glibc < (2, 35):
            pattern = re.compile(r"^fcitx5-wetypex-legacy_[^_]+_amd64\.deb$")
    if not pattern:
        return None
    return next(
        (asset for asset in assets if pattern.fullmatch(asset.get("name", ""))),
        None,
    )


def notify_and_offer_install(package, version, family):
    notify = shutil.which("notify-send")
    if not notify:
        return
    command = [
        notify,
        "--app-name=WeTypeX",
        "--icon=fcitx5-wetypex",
        "--action=install=安装更新",
        f"WeTypeX {version} 已下载",
        f"已校验软件包：{package.name}",
    ]
    try:
        selected = subprocess.run(command, capture_output=True, text=True).stdout.strip()
    except OSError:
        return
    if selected != "install" or not shutil.which("pkexec"):
        return
    installers = {
        "arch": ["pacman", "-U", "--noconfirm", str(package)],
        "debian": ["apt-get", "install", "-y", str(package)],
        "fedora": ["dnf", "install", "-y", str(package)],
    }
    subprocess.Popen(["pkexec", *installers[family]], start_new_session=True)


def main():
    config_home = pathlib.Path(
        os.environ.get("XDG_CONFIG_HOME", pathlib.Path.home() / ".config")
    )
    config = read_json(config_home / "fcitx5/wetypex.json")
    if not config.get("auto_update", True) and "--force" not in sys.argv:
        return 0

    cache_home = pathlib.Path(
        os.environ.get("XDG_CACHE_HOME", pathlib.Path.home() / ".cache")
    )
    root = pathlib.Path(
        os.environ.get("WETYPE_UPDATE_DIR", cache_home / "fcitx5-wetypex/updates")
    )
    root.mkdir(parents=True, exist_ok=True)
    root.chmod(0o700)
    lock = open(root / "update.lock", "a+")
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        lock.close()
        return 0
    try:
        return check_update(root)
    finally:
        lock.close()


def check_update(root):
    state_path = root / "state.json"
    state = read_json(state_path)
    now = int(time.time())
    if "--force" not in sys.argv and now < int(state.get("next_check", 0)):
        return 0
    try:
        release = json.loads(request_bytes(RELEASE_API))
        version = version_tuple(release.get("tag_name", ""))
        current = version_tuple(f"{CURRENT_VERSION}-{CURRENT_PACKAGE_RELEASE}")
        if not version or not current:
            raise ValueError("invalid release version")
        if version <= current:
            atomic_json(
                state_path,
                {
                    "checked_at": now,
                    "next_check": now + CHECK_INTERVAL,
                    "latest_version": release.get("tag_name", ""),
                },
            )
            return 0
        assets = release.get("assets", [])
        family = linux_family()
        package_asset = select_asset(assets, family)
        checksums = next(
            (item for item in assets if item.get("name") == "SHA256SUMS"), None
        )
        if not package_asset or not checksums:
            raise ValueError("release has no package for this distribution")
        package = root / package_asset["name"]
        partial = package.with_suffix(package.suffix + ".part")
        partial.write_bytes(request_bytes(package_asset["browser_download_url"], 120))
        partial.chmod(0o600)
        digest = hashlib.sha256(partial.read_bytes()).hexdigest()
        checksum_text = request_bytes(checksums["browser_download_url"]).decode()
        expected = None
        for line in checksum_text.splitlines():
            fields = line.split()
            if (
                len(fields) >= 2
                and pathlib.PurePosixPath(fields[-1].lstrip("*")).name == package.name
            ):
                expected = fields[0].lower()
                break
        if (
            not expected
            or not re.fullmatch(r"[0-9a-f]{64}", expected)
            or digest != expected
        ):
            partial.unlink(missing_ok=True)
            raise ValueError("release checksum mismatch")
        partial.replace(package)
        atomic_json(
            state_path,
            {
                "checked_at": now,
                "next_check": now + CHECK_INTERVAL,
                "latest_version": release.get("tag_name", ""),
                "package": str(package),
                "sha256": digest,
            },
        )
        if os.environ.get("WETYPE_UPDATE_NO_NOTIFY") != "1":
            notify_and_offer_install(
                package, release["tag_name"].lstrip("v"), family
            )
        return 0
    except (
        OSError,
        ValueError,
        KeyError,
        urllib.error.URLError,
        json.JSONDecodeError,
    ) as error:
        atomic_json(
            state_path,
            {
                "checked_at": now,
                "next_check": now + RETRY_INTERVAL,
                "error": str(error)[:300],
            },
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
