# Sourced by original-runtime consumers. FD 8 remains owned by the outer
# launcher while bubblewrap closes the guest's inherited descriptors.
runtime_data="${XDG_DATA_HOME:-$HOME/.local/share}/fcitx5-wetypex"
mkdir -p "$runtime_data"
while :; do
  exec 8>"$runtime_data/runtime-use.lock"
  flock -s 8
  if [ ! -f "$runtime_data/runtime-transaction.json" ]; then
    break
  fi
  exec 8>&-
  python3 "@CMAKE_INSTALL_FULL_DATADIR@/fcitx5-wetypex/setup_runtime.py" --activate-pending >/dev/null || exit 78
  test ! -f "$runtime_data/runtime-transaction.json" || exit 78
done
