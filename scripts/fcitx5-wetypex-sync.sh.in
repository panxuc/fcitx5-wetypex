#!/usr/bin/env python3
"""Refresh the device group and request synchronization from the native core."""
import json
import os
import pathlib
import socket
import subprocess
import sys
import time

def main():
    if sys.argv[1:] not in ([], ["--refresh-state"]):
        raise ValueError("用法: fcitx5-wetypex-sync [--refresh-state]")
    refresh_state = sys.argv[1:] == ["--refresh-state"]
    config_home = pathlib.Path(os.environ.get("XDG_CONFIG_HOME") or pathlib.Path.home()/".config")
    try:
        config = json.loads((config_home/"fcitx5/wetypex.json").read_text())
    except (OSError, ValueError):
        config = {}
    if isinstance(config, dict) and config.get("standalone", False):
        raise ValueError("单机模式已开启，请关闭后再请求同步")
    data = pathlib.Path(os.environ.get("XDG_DATA_HOME") or pathlib.Path.home()/".local/share")
    state = pathlib.Path(os.environ.get("WETYPE_STATE_DIR") or data/"fcitx5-wetypex/state")
    try:
        cursor = int(json.loads((state/"sync-runtime.json").read_text()).get("remote_version", 0))
    except (OSError, ValueError, TypeError, AttributeError):
        cursor = 0
    tool = os.environ.get("WETYPE_ACCOUNT_TOOL") or "@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-account"
    result = subprocess.run([tool, "group-info", str(max(0, cursor))], capture_output=True, text=True, timeout=35)
    group = json.loads(result.stdout) if result.stdout else {}
    if result.returncode or not isinstance(group, dict) or not group.get("ok"):
        raise ValueError("无法获取设备组，请检查网络与配对状态")
    group_id, functions = int(group.get("group_id", 0)), int(group.get("func_switch", 0))
    if not group_id:
        raise ValueError("尚未关联设备，请先完成设备配对")
    if not functions & 6 and not refresh_state:
        raise ValueError("个人词库和常用语同步均未开启，请先开启对应功能")
    request = {"session": 1, "seq": time.time_ns(), "epoch": 1, "op": "group_sync",
               "group_id": group_id, "func_switch": functions}
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
            client.settimeout(10)
            directory = os.open(state, os.O_RDONLY | os.O_DIRECTORY)
            try:
                client.connect(f"/proc/self/fd/{directory}/control.sock")
            finally:
                os.close(directory)
            client.sendall(json.dumps(request).encode()+b"\n")
            reply = bytearray()
            while b"\n" not in reply:
                chunk = client.recv(4096)
                if not chunk or len(reply)+len(chunk) > 65536:
                    raise ValueError("输入核心返回了无效同步响应")
                reply.extend(chunk)
    except OSError as error:
        raise ValueError("请先启用 WeTypeX 输入法，再请求同步") from error
    response = json.loads(reply.split(b"\n", 1)[0])
    if not isinstance(response, dict):
        raise ValueError("输入核心返回了无效同步响应")
    if not response.get("requested"):
        raise ValueError(response.get("error", "输入核心未接受同步请求"))
    return {"ok": True, "requested": True,
            "dictionary_enabled": bool(functions & 4), "phrases_enabled": bool(functions & 2)}

if __name__ == "__main__":
    try:
        print(json.dumps(main(), ensure_ascii=False))
    except (OSError, ValueError, subprocess.TimeoutExpired) as error:
        print(json.dumps({"ok": False, "requested": False, "error": str(error)}, ensure_ascii=False))
        raise SystemExit(1)
