#!/usr/bin/env python3
"""Synchronize the Fcitx clipboard through the original WeType service."""
import fcntl
import base64
import hashlib
import json
import os
import pathlib
import re
import select
import shutil
import subprocess
import sys
import time
import tempfile

data_home = pathlib.Path(os.environ.get("XDG_DATA_HOME", pathlib.Path.home() / ".local/share"))
state_dir = pathlib.Path(os.environ.get("WETYPE_STATE_DIR", data_home / "fcitx5-wetypex/state"))
account_tool = os.environ.get("WETYPE_ACCOUNT_TOOL", "@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-account")
clipboard_helper = os.environ.get("WETYPE_CLIPBOARD_HELPER", "@CMAKE_INSTALL_FULL_BINDIR@/fcitx5-wetypex-clipboard-set")
state_dir.mkdir(parents=True, exist_ok=True)
state_dir.chmod(0o700)
lock = open(state_dir / "syncd.lock", "a+")
(state_dir / "syncd.lock").chmod(0o600)
try:
    fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
except BlockingIOError:
    raise SystemExit(0)

def atomic_json(path, value):
    temporary = path.with_suffix(path.suffix + ".tmp")
    temporary.write_text(json.dumps(value, ensure_ascii=False) + "\n")
    temporary.chmod(0o600)
    temporary.replace(path)

def call(*arguments):
    try:
        result = subprocess.run([account_tool, *arguments], capture_output=True,
                                text=True, timeout=35)
    except (OSError, subprocess.TimeoutExpired, UnicodeError):
        return {"ok": False}
    if not result.stdout:
        return {"ok": False}
    try:
        value = json.loads(result.stdout)
        return value if isinstance(value, dict) and result.returncode == 0 else {"ok": False}
    except json.JSONDecodeError:
        return {"ok": False}

runtime_path = state_dir / "sync-runtime.json"
try:
    runtime = json.loads(runtime_path.read_text())
except (OSError, json.JSONDecodeError):
    runtime = {}
if not isinstance(runtime, dict):
    runtime = {}
last_group_id = int(runtime.get("group_id", 0))
last_remote_version = int(runtime.get("remote_version", 0))
last_local_kind = str(runtime.get("local_kind", ""))
last_local_digest = str(runtime.get("local_digest", ""))
last_clipboard_enabled = bool(runtime.get("clipboard_enabled", False))
baseline_pending = bool(
    runtime.get("clipboard_baseline_pending", not last_clipboard_enabled))
once = "--once" in sys.argv
clipboard_owner = None
wl_copy = shutil.which("wl-copy") if os.environ.get("WAYLAND_DISPLAY") else None
wl_paste = shutil.which("wl-paste") if os.environ.get("WAYLAND_DISPLAY") else None

def clipboard_command(arguments, environment, input=None):
    try:
        return subprocess.run(arguments, capture_output=True, timeout=4,
                              env=environment, input=input)
    except (OSError, subprocess.TimeoutExpired):
        return None

def _wl_clipboard_protocols(program, environment):
    """Match the installed tool, including old distributions' wl-clipboard."""
    result = clipboard_command([program, "--version"], environment)
    if result is None or result.returncode != 0:
        return None
    match = re.search(rb"wl-clipboard (\d+)\.(\d+)", result.stdout)
    if not match:
        return None
    version = tuple(int(part) for part in match.groups())
    supported = set()
    if version >= (2, 0):
        supported.add("zwlr_data_control_manager_v1")
    if version >= (2, 3):
        supported.add("ext_data_control_manager_v1")
    return supported


def _detect_visible_surface(environment):
    """Query globals without reading the clipboard or creating a surface."""
    if not environment.get("WAYLAND_DISPLAY"):
        return False
    if not wl_paste or not wl_copy:
        return True
    result = clipboard_command(
        [clipboard_helper, "--wayland-clipboard-protocols"], environment)
    if result is None or result.returncode != 0:
        return None
    advertised = set(result.stdout.decode("ascii", "replace").splitlines())
    if not advertised:
        return True
    supported = set(advertised)
    for program in (wl_paste, wl_copy):
        protocols = _wl_clipboard_protocols(program, environment)
        if protocols is None:
            return None
        supported.intersection_update(protocols)
    return not supported


_x11_environment_cache = None
_x11_retry_at = 0
_needs_visible_surface = None


def surface_required(environment):
    """Keep uncertain connections on the silent route; retry the probe later."""
    global _needs_visible_surface
    if _needs_visible_surface is None:
        _needs_visible_surface = _detect_visible_surface(environment)
    return _needs_visible_surface is not False


def _x11_environment(environment):
    """Connect without a Wayland surface, including X11's default authority."""
    global _x11_environment_cache, _x11_retry_at
    if _x11_environment_cache is not None:
        return _x11_environment_cache
    if time.monotonic() < _x11_retry_at:
        return None
    _x11_retry_at = time.monotonic() + 30
    if not environment.get("DISPLAY"):
        return None
    candidate = dict(environment)
    candidate["QT_QPA_PLATFORM"] = "xcb"
    probe = clipboard_command([clipboard_helper, "--read-image"], candidate)
    # 0 means an image was read, 1 means there was no image. Both prove the
    # connection worked. Missing XAUTHORITY may still use X11's default file.
    if probe is None or probe.returncode not in (0, 1):
        return None
    _x11_environment_cache = candidate
    return _x11_environment_cache


def _local_clipboard_silently(environment):
    """Read the clipboard through Qt without creating a Wayland window."""
    global _x11_environment_cache
    x11 = _x11_environment(environment)
    if x11 is None:
        return None
    # A native pasteboard holds one logical item. Prefer its image
    # representation, like the original macOS ClipboardMonitor, then text.
    image = clipboard_command([clipboard_helper, "--read-image"], x11)
    if image and image.returncode == 0 and 0 < len(image.stdout) <= 8388608:
        return "image", image.stdout, hashlib.sha256(image.stdout).hexdigest()
    if image is None or image.returncode not in (0, 1):
        _x11_environment_cache = None
        return None
    text = clipboard_command([clipboard_helper, "--read-text"], x11)
    if text and text.returncode == 0 and 0 < len(text.stdout) <= 16384:
        try:
            text.stdout.decode("utf-8")
        except UnicodeDecodeError:
            return None
        return "text", text.stdout, hashlib.sha256(text.stdout).hexdigest()
    if text is None or text.returncode != 1:
        _x11_environment_cache = None
        return None
    return "empty", b"", hashlib.sha256(b"").hexdigest()

def local_clipboard(environment):
    """Return the one native clipboard item, not independent text/image slots."""
    if surface_required(environment):
        # wl-clipboard would pop a window and steal focus on every poll, which
        # cancels an in-progress composition. Read through XWayland instead.
        # An unavailable X11 connection or failed read must not fall back
        # to a visible Wayland window. Skip this poll and keep input focus.
        return _local_clipboard_silently(environment)
    if wl_paste:
        advertised = clipboard_command([wl_paste, "--list-types"], environment)
        # wl-paste reports an absent selection as exit 1, not a successful
        # empty MIME list. It is a valid empty baseline, so a first remote
        # clipboard can be received without copying anything locally first.
        if (advertised is not None and advertised.returncode == 1 and
                not advertised.stdout and
                advertised.stderr.strip() == b"Nothing is copied"):
            return "empty", b"", hashlib.sha256(b"").hexdigest()
        if not advertised or advertised.returncode != 0:
            return None
        types = (advertised.stdout.decode("utf-8", "replace").splitlines()
                 if advertised and advertised.returncode == 0 else [])
        if "image/png" in types:
            result = clipboard_command(
                [wl_paste, "--no-newline", "--type", "image/png"],
                environment)
            if result and result.returncode == 0 and 0 < len(result.stdout) <= 8388608:
                return "image", result.stdout, hashlib.sha256(result.stdout).hexdigest()
            return None
        if any(item.startswith("text/") or item in ("UTF8_STRING", "STRING")
               for item in types):
            arguments = [wl_paste, "--no-newline"]
            # XWayland may also advertise a legacy STRING/text/plain target.
            # Prefer UTF-8 so a Chinese clipboard is not read as question marks.
            utf8_type = next((item for item in types if item.lower() in
                              ("text/plain;charset=utf-8", "utf8_string")), None)
            if utf8_type:
                arguments += ["--type", utf8_type]
            result = clipboard_command(arguments, environment)
            if result and result.returncode == 0 and len(result.stdout) <= 16384:
                if not result.stdout:
                    return "empty", b"", hashlib.sha256(b"").hexdigest()
                try:
                    result.stdout.decode("utf-8")
                except UnicodeDecodeError:
                    return None
                return "text", result.stdout, hashlib.sha256(result.stdout).hexdigest()
            return None
        return "empty", b"", hashlib.sha256(b"").hexdigest()

    # A native pasteboard contains one logical item even if it advertises
    # several representations. Prefer its image representation, like the
    # original macOS ClipboardMonitor, then fall back to UTF-8 text.
    image = clipboard_command([clipboard_helper, "--read-image"], environment)
    if image and image.returncode == 0 and 0 < len(image.stdout) <= 8388608:
        return "image", image.stdout, hashlib.sha256(image.stdout).hexdigest()
    if image is None or image.returncode != 1:
        return None
    text = clipboard_command([clipboard_helper, "--read-text"], environment)
    if text and text.returncode == 0 and 0 < len(text.stdout) <= 16384:
        try:
            text.stdout.decode("utf-8")
        except UnicodeDecodeError:
            return None
        return "text", text.stdout, hashlib.sha256(text.stdout).hexdigest()
    if text is None or text.returncode != 1:
        return None
    return "empty", b"", hashlib.sha256(b"").hexdigest()

def stop_clipboard_owner():
    global clipboard_owner
    if clipboard_owner and clipboard_owner.poll() is None:
        clipboard_owner.terminate()
        try:
            clipboard_owner.wait(timeout=1)
        except subprocess.TimeoutExpired:
            clipboard_owner.kill()
            clipboard_owner.wait()
    clipboard_owner = None

def set_remote_clipboard(kind, content, environment, expected=None):
    global clipboard_owner, _x11_environment_cache
    # Decoding or normalizing a remote image can take time. Do not overwrite a
    # local copy that happened since the baseline was read, or after a read
    # failure. Keep the remote cursor unchanged so the next poll can retry.
    if expected is not None:
        current = local_clipboard(environment)
        if (current is None or current[0] != expected[0] or
                current[2] != expected[2]):
            return False
    needs_surface = surface_required(environment)
    if needs_surface:
        environment = _x11_environment(environment)
        if environment is None:
            return False
    if wl_copy and not needs_surface:
        mime = "image/png" if kind == "image" else "text/plain;charset=utf-8"
        try:
            result = subprocess.run([wl_copy, "--type", mime], input=content,
                                    timeout=4, stdout=subprocess.DEVNULL,
                                    stderr=subprocess.DEVNULL,
                                    env=environment)
        except (OSError, subprocess.TimeoutExpired):
            return False
        if result.returncode != 0:
            return False
        stop_clipboard_owner()
        return True
    owner = None
    try:
        arguments = [clipboard_helper, "--notify-ready"]
        if kind == "image":
            arguments.append("--image")
        # A file avoids blocking the daemon while writing a large image to
        # a helper that failed to initialize its display connection.
        with tempfile.TemporaryFile() as payload:
            payload.write(content)
            payload.seek(0)
            owner = subprocess.Popen(
                arguments, stdin=payload, stdout=subprocess.PIPE,
                stderr=subprocess.DEVNULL, env=environment)
        readable, _, _ = select.select([owner.stdout], [], [], 4)
        ready = bool(readable and owner.stdout.readline() == b"ready\n")
    except OSError:
        ready = False
    if not ready:
        if needs_surface:
            _x11_environment_cache = None
        if owner:
            if owner.poll() is None:
                owner.kill()
            owner.wait()
        return False
    owner.stdout.close()
    stop_clipboard_owner()
    clipboard_owner = owner
    return True

# Older releases had a second clipboard producer in the input-method plugin
# and a persistent inbox consumer. Neither file represents a current user
# clipboard event, so replaying them after an upgrade would resurrect stale
# content. The daemon is now the sole owner of synchronization.
for obsolete in (state_dir / "clipboard-inbox.json",
                 state_dir / "clipboard-outbox.json"):
    try:
        obsolete.unlink()
    except FileNotFoundError:
        pass

while True:
    helper_environment = os.environ.copy()
    helper_environment["QT_IM_MODULE"] = "none"
    # wl-paste may create a visible temporary toplevel on compositors without
    # data-control support (notably GNOME/Mutter). Do not touch the system
    # clipboard unless the paired device group currently has clipboard sync on.
    group = call("group-info", str(last_remote_version))
    if group.get("ok"):
        atomic_json(state_dir / "sync-state.json", group)
        group_id = int(group.get("group_id", 0))
        functions = int(group.get("func_switch", 0))
        clipboard_enabled = bool(group_id and functions & 1)
        same_group = group_id == last_group_id
        was_clipboard_enabled = last_clipboard_enabled and same_group

        # Clipboard version counters are scoped to a device group. On first
        # start, re-pairing, or disabled sync, establish a local baseline and
        # never upload clipboard data that predates that state transition.
        if group_id != last_group_id:
            last_group_id = group_id
            last_remote_version = 0
            baseline_pending = True
        if not clipboard_enabled:
            baseline_pending = True
        elif not was_clipboard_enabled:
            baseline_pending = True

        local = None
        if clipboard_enabled:
            # Only a fresh read after the network request may authorize a
            # receive. A previous empty selection can become new local data
            # while fetching; a failed current read must not overwrite it.
            local = local_clipboard(helper_environment)
            local_kind = local[0] if local else ""
            local_digest = local[2] if local else ""
            if baseline_pending and local is not None:
                # Starting or re-enabling sync establishes a baseline. Do not
                # upload the clipboard contents that already existed then.
                last_local_kind = local[0]
                last_local_digest = local[2]
                baseline_pending = False

        if clipboard_enabled and local is not None and not baseline_pending:
            version = int(group.get("clipboard_version", 0))
            remote = str(group.get("clipboard", ""))
            remote_type = int(group.get("clipboard_type", 0))
            remote_binary = str(group.get("clipboard_binary", ""))
            from_uin = int(group.get("clipboard_from_uin", 0))
            self_uin = int(group.get("self_uin", 0))
            expire_at = int(group.get("clipboard_expire_at", 0))
            if 0 < expire_at < 100000000000:
                expire_at *= 1000
            expired = bool(expire_at and expire_at <= int(time.time() * 1000))

            local_changed = bool(
                local is not None and not baseline_pending and
                (not last_local_digest or local_kind != last_local_kind or
                 local_digest != last_local_digest))
            if local_changed:
                if local_kind == "empty":
                    # Empty clipboard is local state, but the service has no
                    # empty-message type. Remember it so copying the same value
                    # again is still observed as a new event.
                    last_local_kind = local_kind
                    last_local_digest = local_digest
                    sent = {}
                elif local_kind == "image":
                    image_path = state_dir / "clipboard-outbox.png"
                    temporary = image_path.with_suffix(".png.tmp")
                    temporary.write_bytes(local[1])
                    temporary.chmod(0o600)
                    temporary.replace(image_path)
                    sent = call("send-image", str(group_id), str(image_path))
                else:
                    sent = call("send-clipboard", str(group_id),
                                local[1].decode("utf-8"))
                if sent.get("ok"):
                    # SendClipboardMsgRsp.version is the same monotonic cursor
                    # advanced by the native clients after a local upload.
                    last_remote_version = max(
                        last_remote_version, int(sent.get("version", 0)))
                    last_local_kind = local_kind
                    last_local_digest = local_digest
            elif version > last_remote_version and expired:
                last_remote_version = version
            elif (version > last_remote_version and from_uin and self_uin and
                  from_uin == self_uin):
                # A response can race the upload acknowledgement. Advance the
                # cursor, but never paste our own clipboard back over the user.
                last_remote_version = version
            elif (version > last_remote_version and
                  remote_type in (5, 6, 100) and remote_binary):
                try:
                    image = base64.b64decode(remote_binary, validate=True)
                except (ValueError, base64.binascii.Error):
                    image = b""
                if 0 < len(image) <= 8388608:
                    normalized = clipboard_command(
                        [clipboard_helper, "--normalize-image"], input=image,
                        environment=helper_environment)
                    if normalized is None:
                        image = b""
                    elif (normalized.returncode != 0 or not normalized.stdout or
                          len(normalized.stdout) > 8388608):
                        image = b""
                        last_remote_version = version
                    else:
                        image = normalized.stdout
                else:
                    image = b""
                    last_remote_version = version
                if image and set_remote_clipboard("image", image,
                                                  helper_environment, local):
                    last_local_kind = "image"
                    last_local_digest = hashlib.sha256(image).hexdigest()
                    last_remote_version = version
            elif version > last_remote_version and remote:
                encoded = remote.encode("utf-8")
                if (len(encoded) <= 16384 and
                        set_remote_clipboard("text", encoded,
                                             helper_environment, local)):
                    last_local_kind = "text"
                    last_local_digest = hashlib.sha256(encoded).hexdigest()
                    last_remote_version = version
            elif version > last_remote_version:
                # Do not retry malformed or unsupported messages forever.
                last_remote_version = version
        atomic_json(runtime_path, {"group_id": last_group_id,
                                   "remote_version": last_remote_version,
                                   "local_kind": last_local_kind,
                                   "local_digest": last_local_digest,
                                   "clipboard_enabled": clipboard_enabled,
                                   "clipboard_baseline_pending": baseline_pending})
        last_clipboard_enabled = clipboard_enabled
    if once:
        break
    time.sleep(3 if group.get("ok") else 10)
